[flake8]
max-line-length = 88
select = E,W,F,C
ignore = 
    E203,
    E501,
    W503,
    C901

per-file-ignores =
    __init__.py:F401
    tests/*:S101

max-complexity = 10
exclude = 
    .git,
    __pycache__,
    build,
    3rdparty,
    .venv,
    venv

[bandit]
exclude_dirs = tests,3rdparty
skips = B101,B601